def find_numeric_column_pairs(columns: list) -> list:
    """Heuristic: numeric columns whose names share a word token (e.g.
    "source_rate"/"target_rate", "fee_pct"/"fee_fixed") are candidates for
    difference/ratio/product features -- the kind of pairing that shows up
    a lot in financial/transactional schemas."""
    pairs = []
    tokens = {c: set(c.lower().replace("-", "_").split("_")) for c in columns}
    for a, b in itertools.combinations(columns, 2):
        if tokens[a] & tokens[b]:
            pairs.append((a, b))
    return pairs


numeric_cols = combined.select_dtypes(include=[np.number]).columns.tolist()
numeric_cols = [c for c in numeric_cols if c not in (TARGET_COL, "_is_train")]

candidate_pairs = find_numeric_column_pairs(numeric_cols)
print(f"found {len(candidate_pairs)} candidate numeric pairs: {candidate_pairs}")

for a, b in candidate_pairs:
    combined[f"{a}_minus_{b}"] = combined[a] - combined[b]
    combined[f"{a}_div_{b}"] = combined[a] / combined[b].replace(0, np.nan)
    combined[f"{a}_times_{b}"] = combined[a] * combined[b]
